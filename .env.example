# Copy to .env and fill in. The real .env is git-ignored.

# Release signing. Without these the build falls back to the debug key.
KOSHT_KEYSTORE_FILE=kosht-release.jks
KOSHT_KEY_ALIAS=kosht
KOSHT_STORE_PASSWORD=
KOSHT_KEY_PASSWORD=

# Supabase project. Only these two reach the APK.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Owner token (sbp_...); only scripts/supabase-mailer.ps1 reads it.
SUPABASE_ACCESS_TOKEN=

# AdMob. Left empty the build uses Google's test IDs, which serve test ads to
# any device — safe, and no invalid traffic against the real account.
ADMOB_APP_ID=
ADMOB_BANNER_UNIT_ID=

# Mailbox Supabase sends the codes from (Dashboard, not the APK).
KOSHT_SMTP_HOST=smtp.gmail.com
KOSHT_SMTP_PORT=465
KOSHT_SMTP_USER=
KOSHT_SMTP_PASSWORD=
KOSHT_SMTP_SENDER=
KOSHT_SMTP_SENDER_NAME=Kosht
