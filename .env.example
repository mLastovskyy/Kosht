# Copy to .env and fill in. The real .env is git-ignored.
#
# These describe the release signing key. Without them (or with the file
# missing) the build falls back to the debug key, which is fine for
# personal installs but rejected by Google Play and AppGallery.
#
# Create a key once:
#   keytool -genkeypair -v -keystore kosht-release.jks -storetype PKCS12 \
#     -keyalg RSA -keysize 4096 -validity 10000 -alias kosht
#
# Back up BOTH the .jks file and these passwords. Losing them means you
# can never update an app already published under this key.

KOSHT_KEYSTORE_FILE=kosht-release.jks
KOSHT_KEY_ALIAS=kosht
KOSHT_STORE_PASSWORD=
KOSHT_KEY_PASSWORD=

# Supabase project. Only the URL and the anon key reach the APK; the anon key
# is public by design and row level security is what protects the data.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Mailbox the sign-up and password-reset codes are sent from. Nothing here is
# compiled into the app: paste these into Dashboard → Project Settings →
# Authentication → SMTP Settings, and Supabase does the sending.
#
# With Gmail, KOSHT_SMTP_PASSWORD is an app password from
# myaccount.google.com/apppasswords — written without the spaces Google shows
# it with — and the sender has to be the mailbox itself.
KOSHT_SMTP_HOST=smtp.gmail.com
KOSHT_SMTP_PORT=465
KOSHT_SMTP_USER=
KOSHT_SMTP_PASSWORD=
KOSHT_SMTP_SENDER=
KOSHT_SMTP_SENDER_NAME=Kosht
