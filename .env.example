# Copy to .env and fill in. The real .env is git-ignored.
#
# These describe the release signing key. Without them (or with the file
# missing) the build falls back to the debug key, which is fine for
# personal installs but rejected by Google Play and AppGallery.
#
# Create a key once:
#   keytool -genkeypair -v -keystore kosht-release.jks -storetype PKCS12 \
#     -keyalg RSA -keysize 4096 -validity 10000 -alias kosht
#
# Back up BOTH the .jks file and these passwords. Losing them means you
# can never update an app already published under this key.

KOSHT_KEYSTORE_FILE=kosht-release.jks
KOSHT_KEY_ALIAS=kosht
KOSHT_STORE_PASSWORD=
KOSHT_KEY_PASSWORD=
