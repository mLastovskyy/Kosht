<?xml version="1.0" encoding="utf-8"?><!--
   The app lock stays out of both a cloud backup and a phone-to-phone transfer:
   the code belongs to the device it was chosen on. Everything else may travel,
   and the records themselves go through the account — a choice, not something
   inherited from a restore.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/app_lock.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/app_lock.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
