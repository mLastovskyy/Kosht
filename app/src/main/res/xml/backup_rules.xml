<?xml version="1.0" encoding="utf-8"?><!--
   Everything may be backed up except the app lock: the code belongs to the
   phone it was chosen on, and a lock that arrives with a restore is a lock its
   owner never set. Records travel through the account instead — a choice made
   on purpose rather than inherited from a backup.
   Note: this file is used on devices older than API 31; newer ones read
   data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/app_lock.preferences_pb" />
</full-backup-content>
