    <!-- In-app guide -->
    <string name="guide_title">How to use Kosht</string>
    <string name="guide_screen_of">Screen %1$d of 5</string>
    <string name="guide_group_screens">THE FIVE SCREENS</string>
    <string name="guide_group_record">WRITING IT DOWN</string>
    <string name="guide_group_more">EVERYTHING ELSE</string>
    <string name="guide_home_lines">The total balance and the totals for this month.\nAccount tiles once you keep more than one.\nRecent records: tap to edit, "See all" for History.\nUp top: the streak, the awards and your profile.</string>
    <string name="guide_history_lines">Every record by day, with the total for the day above it.\nSearch by note and category, filters and a period.\nA basket on a record opens what it was made of.\nDeleting lives inside the record, asks first; "Undo" waits below.</string>
    <string name="guide_stats_lines">A category donut with the total inside; days below it.\nTap a slice to name its category, tap a category to open the items.\nTap a bar in the daily chart to see that day\'s total.\nCalendar: the darker the day, the more it cost.</string>
    <string name="guide_wallet_lines">Bank rates, accounts and transfers between them.\nPayments wait for confirmation; Skip moves one on without a record.\nDebts, goals and savings: a tap opens one for editing.</string>
    <string name="guide_settings_lines">Profile, theme, language, currency.\nAccounts, cash withdrawal rate, notifications, security.\nAt the bottom: the manual, the documents and the version.</string>
    <string name="guide_add_head">A new record</string>
    <string name="guide_add_lines">The + button on Home or in History.\nSum, category, Save.\nExpense or income — the switch, or a swipe across the sum.\nChips beside it: date, account, items.\nTo savings or Debt repayment offer your goals and debts.</string>
    <string name="guide_calc_head">Calculator</string>
    <string name="guide_calc_lines">It opens by itself for a new record.\nIt counts: 12.50+3.90; the button shows "=" until it is done.\nApply writes the sum into the record.</string>
    <string name="guide_items_head">Items</string>
    <string name="guide_items_lines">What a record is made of: goods, or parts of a payment.\nAn empty sum is taken from the items.\nIf the items come to more, saving asks first.\nIn statistics they break the category down.</string>
    <string name="guide_scan_head">Receipt scanning</string>
    <string name="guide_scan_lines">Photograph the slip or pick a photo from the gallery.\nThe sum, shop, date and items fill themselves in.\nA QR code leads to the electronic receipt — exact figures.\nIt all runs on the phone; the photo stays here.</string>
    <string name="guide_streak_head">Streak and awards</string>
    <string name="guide_streak_lines">The streak counts days inside your daily budget.\nChallenges are yours to set — a chip or dates of your own.\nA saving one carries its currency and a goal in the Wallet.\nAwards arrive by themselves once earned.</string>
    <string name="guide_lock_head">App lock</string>
    <string name="guide_lock_lines">A code of your own, plus fingerprint entry.\nSet how many minutes before it asks again.\nThe code is never kept in the clear.</string>
    <string name="guide_sync_head">Account</string>
    <string name="guide_sync_lines">With no account everything stays on the phone.\nWith one, your records match on every phone of yours.\nOffline works as usual and goes up when there is a network.</string>
    <string name="guide_update_head">Updates</string>
    <string name="guide_update_lines">Settings → Version: a tap checks for a new one.\nThe app downloads and installs it itself.\nYour data stays where it is.</string>
